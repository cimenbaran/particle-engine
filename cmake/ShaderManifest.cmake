include("${CMAKE_CURRENT_LIST_DIR}/ShaderFingerprint.cmake")
file(SHA256 "${BINARY}" binary_hash)
set(manifest "{}")
foreach(field schema shader platform profile type defines source_sha256 varying_sha256 includes_sha256 compiler_sha256 binary_sha256 fingerprint)
  if(field STREQUAL "schema")
    set(value "2")
  else()
    if(field STREQUAL "shader")
      set(raw "${shader_name}")
    elseif(field STREQUAL "platform")
      set(raw "${PLATFORM}")
    elseif(field STREQUAL "profile")
      set(raw "${PROFILE}")
    elseif(field STREQUAL "type")
      set(raw "${KIND}")
    elseif(field STREQUAL "defines")
      set(raw "${DEFINES}")
    elseif(field STREQUAL "source_sha256")
      set(raw "${source_hash}")
    elseif(field STREQUAL "varying_sha256")
      set(raw "${varying_hash}")
    elseif(field STREQUAL "includes_sha256")
      set(raw "${include_hash}")
    elseif(field STREQUAL "compiler_sha256")
      set(raw "${compiler_hash}")
    elseif(field STREQUAL "binary_sha256")
      set(raw "${binary_hash}")
    else()
      set(raw "${fingerprint}")
    endif()
    string(REPLACE "\\" "\\\\" raw "${raw}")
    string(REPLACE "\"" "\\\"" raw "${raw}")
    set(value "\"${raw}\"")
  endif()
  string(JSON manifest SET "${manifest}" "${field}" "${value}")
endforeach()
file(WRITE "${OUTPUT}" "${manifest}\n")
