# Build-time provenance for each packaged binary. Includes are deliberately
# conservative: any bgfx shader include change invalidates the fingerprint.
file(SHA256 "${SOURCE}" source_hash)
file(SHA256 "${VARYING}" varying_hash)
file(SHA256 "${COMPILER}" compiler_hash)
file(GLOB_RECURSE includes "${INCLUDE_ROOT}/*.sh")
list(SORT includes)
set(include_material "")
foreach(path IN LISTS includes)
  file(SHA256 "${path}" hash)
  file(RELATIVE_PATH relative "${INCLUDE_ROOT}" "${path}")
  string(APPEND include_material "${relative}:${hash}\n")
endforeach()
file(GLOB_RECURSE project_includes "${PROJECT_INCLUDE_ROOT}/*.sh")
list(SORT project_includes)
foreach(path IN LISTS project_includes)
  file(SHA256 "${path}" hash)
  file(RELATIVE_PATH relative "${PROJECT_INCLUDE_ROOT}" "${path}")
  string(APPEND include_material "project/${relative}:${hash}\n")
endforeach()
string(SHA256 include_hash "${include_material}")
get_filename_component(shader_name "${SOURCE}" NAME)
set(recipe_material "")
foreach(recipe CompileShader.cmake ShaderManifest.cmake ShaderFingerprint.cmake)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${recipe}" recipe_part)
  string(APPEND recipe_material "${recipe}:${recipe_part}|")
endforeach()
string(SHA256 recipe_hash "${recipe_material}")
string(SHA256 fingerprint "v2|${shader_name}|${source_hash}|${varying_hash}|${include_hash}|${compiler_hash}|${PLATFORM}|${PROFILE}|${KIND}|defines=${DEFINES}|${recipe_hash}")
