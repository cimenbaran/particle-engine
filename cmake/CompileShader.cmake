# A per-fingerprint lock makes sharing the cache across builds safe. Invalid
# entries are rebuilt; a failed compiler never replaces local working assets.
include("${CMAKE_CURRENT_LIST_DIR}/ShaderFingerprint.cmake")
file(MAKE_DIRECTORY "${CACHE_DIR}")
set(entry "${CACHE_DIR}/${fingerprint}")
file(LOCK "${entry}.lock" GUARD PROCESS TIMEOUT 120)
set(hit FALSE)
if(EXISTS "${entry}.bin" AND EXISTS "${entry}.json")
  file(READ "${entry}.json" cached_manifest)
  string(JSON cached_key ERROR_VARIABLE key_error GET "${cached_manifest}" fingerprint)
  string(JSON cached_hash ERROR_VARIABLE hash_error GET "${cached_manifest}" binary_sha256)
  file(SHA256 "${entry}.bin" actual_hash)
  if(NOT key_error AND NOT hash_error AND cached_key STREQUAL fingerprint AND cached_hash STREQUAL actual_hash)
    set(hit TRUE)
  endif()
endif()
if(hit)
  message(STATUS "Shader cache hit: ${shader_name}")
else()
  execute_process(COMMAND "${COMPILER}" -f "${SOURCE}" -o "${entry}.tmp"
    --type "${KIND}" --platform "${PLATFORM}" --profile "${PROFILE}"
    --varyingdef "${VARYING}" -i "${INCLUDE_ROOT}" --define "${DEFINES}"
    RESULT_VARIABLE result OUTPUT_VARIABLE compiler_output ERROR_VARIABLE compiler_error)
  if(NOT result EQUAL 0 OR NOT EXISTS "${entry}.tmp")
    file(REMOVE "${entry}.tmp")
    message(FATAL_ERROR "Shader compilation failed for ${shader_name}; previous output retained.\n${compiler_output}\n${compiler_error}")
  endif()
  # Generate the manifest against the new binary before publishing either file.
  set(destination_binary "${BINARY}")
  set(destination_manifest "${OUTPUT}")
  set(BINARY "${entry}.tmp")
  set(OUTPUT "${entry}.json.tmp")
  include("${CMAKE_CURRENT_LIST_DIR}/ShaderManifest.cmake")
  set(BINARY "${destination_binary}")
  set(OUTPUT "${destination_manifest}")
  file(RENAME "${entry}.tmp" "${entry}.bin")
  file(RENAME "${entry}.json.tmp" "${entry}.json")
  message(STATUS "Shader compiled: ${shader_name}")
endif()
get_filename_component(output_dir "${BINARY}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(COPY_FILE "${entry}.bin" "${BINARY}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${entry}.json" "${OUTPUT}" ONLY_IF_DIFFERENT)
# Ninja must see outputs newer than dependencies even for identical cache hits.
file(TOUCH "${BINARY}" "${OUTPUT}")
