file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}/source" "${TEST_DIR}/project-includes")
file(WRITE "${TEST_DIR}/project-includes/test.sh" "// include version 1\n")
file(COPY "${ROOT}/shaders/compute/cs_pool_clear.sc" DESTINATION "${TEST_DIR}/source")
set(source "${TEST_DIR}/source/cs_pool_clear.sc")
set(binary "${TEST_DIR}/output/shader.bin")
function(compile expected)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE=${source}" "-DVARYING=${ROOT}/shaders/render/varying.def.sc"
    "-DINCLUDE_ROOT=${INCLUDE_ROOT}" "-DPROJECT_INCLUDE_ROOT=${TEST_DIR}/project-includes"
    "-DCOMPILER=${COMPILER}" "-DBINARY=${binary}" "-DOUTPUT=${binary}.json"
    "-DCACHE_DIR=${TEST_DIR}/cache" "-DPLATFORM=${PLATFORM}" "-DPROFILE=${PROFILE}"
    "-DKIND=compute" "-DDEFINES=${defines}" -P "${ROOT}/cmake/CompileShader.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL "failed")
    if(result EQUAL 0 OR NOT error MATCHES "previous output retained")
      message(FATAL_ERROR "Expected preserved-output compiler failure: ${output} ${error}")
    endif()
  elseif(NOT result EQUAL 0 OR NOT output MATCHES "Shader ${expected}:")
    message(FATAL_ERROR "Expected ${expected}, got: ${output} ${error}")
  endif()
endfunction()
compile("compiled")
file(SHA256 "${binary}" original_hash)
file(READ "${binary}.json" manifest)
string(JSON original_key GET "${manifest}" fingerprint)
compile("cache hit")
# A corrupt binary or malformed manifest cannot be accepted on a cache hit.
file(WRITE "${TEST_DIR}/cache/${original_key}.bin" "corrupt")
compile("compiled")
file(SHA256 "${binary}" restored_hash)
if(NOT restored_hash STREQUAL original_hash)
  message(FATAL_ERROR "Repair changed the compiled shader")
endif()
file(WRITE "${TEST_DIR}/cache/${original_key}.json" "malformed")
compile("compiled")
# Defines are part of the key, even when unused by this particular source.
set(defines "PW_TEST_A=1;PW_TEST_B=2")
compile("compiled")
file(READ "${binary}.json" manifest)
string(JSON defined_key GET "${manifest}" fingerprint)
string(JSON recorded_defines GET "${manifest}" defines)
if(defined_key STREQUAL original_key OR NOT recorded_defines STREQUAL defines)
  message(FATAL_ERROR "Defines were not included in the cache key and manifest")
endif()
compile("cache hit")
set(defines "")
compile("cache hit")
# Conservative include hashing invalidates even an unused project include.
file(WRITE "${TEST_DIR}/project-includes/test.sh" "// include version 2\n")
compile("compiled")
compile("cache hit")
file(WRITE "${TEST_DIR}/project-includes/test.sh" "// include version 1\n")
compile("cache hit")
file(APPEND "${source}" "\n// changed source input\n")
compile("compiled")
file(COPY "${ROOT}/shaders/compute/cs_pool_clear.sc" DESTINATION "${TEST_DIR}/source")
compile("cache hit")
# Another checkout/output path should reuse the same content, without shaderc.
file(MAKE_DIRECTORY "${TEST_DIR}/relocated")
file(COPY "${source}" DESTINATION "${TEST_DIR}/relocated")
set(source "${TEST_DIR}/relocated/cs_pool_clear.sc")
set(binary "${TEST_DIR}/relocated/output.bin")
compile("cache hit")
file(READ "${binary}.json" last_manifest)
file(WRITE "${source}" "THIS IS NOT A VALID SHADER\n")
compile("failed")
file(SHA256 "${binary}" retained_hash)
file(READ "${binary}.json" retained_manifest)
if(NOT retained_hash STREQUAL original_hash OR NOT retained_manifest STREQUAL last_manifest)
  message(FATAL_ERROR "Failed compilation replaced the working shader")
endif()
message(STATUS "Shader cache reuse, corruption repair, defines, relocation and failure retention passed")
